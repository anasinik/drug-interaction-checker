template header
medicationName
diagnosis
severity
reason
factor

package com.ftn.sbnz.kjar.rules;
import com.ftn.sbnz.model.domain.*;

template "drug-disease-interaction-by-name"

rule "Drug-Disease Interaction (named): @{medicationName} + @{diagnosis} - row @{row.rowNumber}"
when
    $req : MedicationRequest(
        $patient : patient,
        $newMed : newMedication
    )
    eval($newMed.getName().equalsIgnoreCase("@{medicationName}"))
    eval($patient.hasDiagnosis("@{diagnosis}"))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMed,
        InteractionType.DRUG_DISEASE,
        SeverityLevel.@{severity},
        SeverityLevel.@{severity}.getScore(),
        "@{reason}",
        "@{factor}"
    ));
end

end template