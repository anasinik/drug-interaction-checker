template header
foodHabit
medicationCategory
severity
reason
factor

package com.ftn.sbnz.kjar.rules;
import com.ftn.sbnz.model.domain.*;

template "drug-food-interaction"

rule "Drug-Food Interaction: @{foodHabit} + @{medicationCategory} - row @{row.rowNumber}"
when
    $req : MedicationRequest(
        $patient : patient,
        $newMed : newMedication,
        newMedication.category == MedicationCategory.@{medicationCategory}
    )
    eval($patient.hasFoodHabit(FoodHabit.@{foodHabit}))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMed,
        InteractionType.DRUG_FOOD,
        SeverityLevel.@{severity},
        SeverityLevel.@{severity}.getScore(),
        "@{reason}",
        "@{factor}"
    ));
end

end template