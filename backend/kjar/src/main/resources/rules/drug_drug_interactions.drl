package com.ftn.sbnz.kjar.templates;
import com.ftn.sbnz.model.domain.*;

rule "Drug-Drug Interaction: ANTICOAGULANT + ANTIBIOTIC - row 0"
when
    $req : MedicationRequest(
        $patient : patient,
        $newMed : newMedication
    )
    (
        MedicationRequest(
            newMedication.category == MedicationCategory.ANTIBIOTIC
        ) and
        exists Medication(category == MedicationCategory.ANTICOAGULANT)
            from $patient.currentMedications
    ) or (
        MedicationRequest(
            newMedication.category == MedicationCategory.ANTICOAGULANT
        ) and
        exists Medication(category == MedicationCategory.ANTIBIOTIC)
            from $patient.currentMedications
    )
    $existing : Medication(
        category == MedicationCategory.ANTICOAGULANT ||
        category == MedicationCategory.ANTIBIOTIC,
        category != $newMed.category
    ) from $patient.currentMedications
then
    insert(new DetectedInteraction(
        $patient,
        $existing,
        $newMed,
        InteractionType.DRUG_DRUG,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Antibiotics reduce vitamin K-producing bacteria..."
    ));
end

