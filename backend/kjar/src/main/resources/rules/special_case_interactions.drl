package com.ftn.sbnz.kjar.rules;

import com.ftn.sbnz.model.domain.*;

dialect "java"

// SPECIAL CASE DRUG-DISEASE INTERACTIONS:

rule "Amitriptyline and arrhythmia serious interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Amitriptyline"))
    eval($patient.hasDiagnosis("cardiac arrhythmia"))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMedication,
        InteractionType.DRUG_DISEASE,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Amitriptyline may worsen arrhythmia in cardiac patients.",
        "cardiac arrhythmia"));
end

rule "Penicillin allergy and penicillin antibiotic contraindicated"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication,
                                   newMedication.category == MedicationCategory.ANTIBIOTIC )
    eval($patient.hasAllergy("penicillin") &&
         ($newMedication.getName().toLowerCase().contains("penicillin") ||
          $newMedication.getName().toLowerCase().contains("amoxicillin") ||
          $newMedication.getName().toLowerCase().contains("ampicillin") ||
          $newMedication.getName().toLowerCase().contains("oxacillin")))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMedication,
        InteractionType.DRUG_DISEASE,
        SeverityLevel.CONTRAINDICATED,
        SeverityLevel.CONTRAINDICATED.getScore(),
        "Penicillin allergy with a penicillin antibiotic is contraindicated due to anaphylaxis risk.",
        "penicillin"));
end


// SPECIAL CASE DRUG-DRUG INTERACTIONS:

rule "Aspirin and anticoagulant serious interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Aspirin"))
    eval($patient.hasMedicationByCategory(MedicationCategory.ANTICOAGULANT))
then
    insert(new DetectedInteraction(
        $patient,
        $patient.findMedicationByCategory(MedicationCategory.ANTICOAGULANT),
        $newMedication,
        InteractionType.DRUG_DRUG,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Aspirin has antiplatelet effects. Combined with an anticoagulant, it significantly increases bleeding risk.",
        "antiplatelet effect"));
end

rule "Ibuprofen and anticoagulant serious interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Ibuprofen"))
    eval($patient.hasMedicationByCategory(MedicationCategory.ANTICOAGULANT))
then
    insert(new DetectedInteraction(
        $patient,
        $patient.findMedicationByCategory(MedicationCategory.ANTICOAGULANT),
        $newMedication,
        InteractionType.DRUG_DRUG,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Ibuprofen inhibits platelet aggregation and irritates the gastric mucosa. Combined with an anticoagulant, it increases risk of serious GI bleeding.",
        "gastric irritation"));
end

rule "Simvastatin and Erythromycin contraindicated interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Simvastatin"))
    $existing : Medication() from $patient.getCurrentMedications()
    eval($existing.getName().equalsIgnoreCase("Erythromycin"))
then
    insert(new DetectedInteraction(
        $patient,
        $existing,
        $newMedication,
        InteractionType.DRUG_DRUG,
        SeverityLevel.CONTRAINDICATED,
        SeverityLevel.CONTRAINDICATED.getScore(),
        "Erythromycin strongly inhibits CYP3A4 and dramatically increases simvastatin plasma levels, causing high risk of rhabdomyolysis.",
        "CYP3A4 inhibition"));
end


// SPECIAL CASE DRUG-FOOD INTERACTIONS:

rule "Metronidazole and alcohol contraindicated interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Metronidazole"))
    eval($patient.hasFoodHabit(FoodHabit.ALCOHOL))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMedication,
        InteractionType.DRUG_FOOD,
        SeverityLevel.CONTRAINDICATED,
        SeverityLevel.CONTRAINDICATED.getScore(),
        "Metronidazole with alcohol is contraindicated - causes severe reactions (nausea, vomiting, tachycardia).",
        "alcohol consumption"));
end

rule "Warfarin and vitamin K rich food serious interaction"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Warfarin"))
    eval($patient.hasFoodHabit(FoodHabit.VITAMIN_K_RICH))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMedication,
        InteractionType.DRUG_FOOD,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Warfarin is highly sensitive to vitamin K. Vitamin K-rich food significantly reduces warfarin efficacy and increases clotting risk.",
        "vitamin k rich food"));
end

rule "Metformin and alcohol lactic acidosis risk"
when
    $request : MedicationRequest( $patient : patient, $newMedication : newMedication )
    eval($newMedication.getName().equalsIgnoreCase("Metformin"))
    eval($patient.hasFoodHabit(FoodHabit.ALCOHOL))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMedication,
        InteractionType.DRUG_FOOD,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Metformin combined with alcohol increases risk of lactic acidosis, a rare but life-threatening condition.",
        "alcohol consumption"));
end

// special_cases.drl
rule "Two anticoagulants contraindicated"
when
    $request : MedicationRequest( $patient : patient, $newMed : newMedication,
                                   newMedication.category == MedicationCategory.ANTICOAGULANT )
    exists Medication( category == MedicationCategory.ANTICOAGULANT )
        from $patient.currentMedications
then
    insert(new DetectedInteraction(
        $patient,
        $patient.findMedicationByCategory(MedicationCategory.ANTICOAGULANT),
        $newMed,
        InteractionType.DRUG_DRUG,
        SeverityLevel.CONTRAINDICATED,
        SeverityLevel.CONTRAINDICATED.getScore(),
        "Two anticoagulants simultaneously carry extreme bleeding risk.",
        "anticoagulant overlap"));
end