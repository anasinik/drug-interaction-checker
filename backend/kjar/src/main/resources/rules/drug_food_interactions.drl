package com.ftn.sbnz.kjar.templates;
import com.ftn.sbnz.model.domain.*;

rule "Drug-Food Interaction: VITAMIN_K_RICH + ANTICOAGULANT - row 0"
when
    $req : MedicationRequest(
        $patient : patient,
        $newMed : newMedication,
        newMedication.category == MedicationCategory.ANTICOAGULANT
    )
    eval($patient.hasFoodHabit(FoodHabit.VITAMIN_K_RICH))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMed,
        InteractionType.DRUG_FOOD,
        SeverityLevel.MILD,
        SeverityLevel.MILD.getScore(),
        "Vitamin K reduces anticoagulant efficacy, may cause unwanted blood clotting"
    ));
end

rule "Drug-Food Interaction: GRAPEFRUIT + STATIN - row 1"
when
    $req : MedicationRequest(
        $patient : patient,
        $newMed : newMedication,
        newMedication.category == MedicationCategory.STATIN
    )
    eval($patient.hasFoodHabit(FoodHabit.GRAPEFRUIT))
then
    insert(new DetectedInteraction(
        $patient,
        null,
        $newMed,
        InteractionType.DRUG_FOOD,
        SeverityLevel.SERIOUS,
        SeverityLevel.SERIOUS.getScore(),
        "Grapefruit inhibits CYP3A4 enzyme causing drug accumulation and muscle damage risk"
    ));
end

